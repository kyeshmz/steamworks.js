{
    "name": "@kyeshmz/steamworks.js",
    "version": "0.4.0",
    "packageManager": "pnpm@10.34.0",
    "main": "index.js",
    "types": "index.d.ts",
    "napi": {
        "name": "steamworksjs",
        "triples": {
            "additional": [
                "x86_64-pc-windows-msvc",
                "x86_64-unknown-linux-gnu",
                "x86_64-apple-darwin",
                "aarch64-apple-darwin"
            ]
        }
    },
    "files": [
        "dist/*",
        "index.js",
        "*.d.ts",
        "lib/sdk/*.js",
        "lib/sdk/*.d.ts",
        "README.md",
        "CHANGELOG.md"
    ],
    "license": "MIT",
    "devDependencies": {
        "@napi-rs/cli": "2.18.4",
        "electron": "24.2.0",
        "rimraf": "6.0.1",
        "typescript": "5.5.3"
    },
    "dependencies": {
        "@types/node": "20.14.0"
    },
    "engines": {
        "node": ">= 14"
    },
    "scripts": {
        "build": "node build --release",
        "build:debug": "node build",
        "prune": "rimraf dist target client.d.ts",
        "format": "cargo clippy --fix --allow-staged && cargo fmt",
        "types": "tsc index.js --allowJs --declaration --emitDeclarationOnly",
        "generate": "node scripts/sdk/generate.mjs",
        "test:sdk": "node test/sdk-offline.js"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kyeshmz/steamworks.js.git"
    }
}
